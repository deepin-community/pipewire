+		return res;
 	if (state->following && state->rt.driver == NULL) {
 		uint64_t current_time = state->position->clock.nsec;
 		alsa_read_sync(state, current_time);
@@ -3856,6 +3905,9 @@
 			if (!state->disable_tsched)
 				set_timeout(state, state->next_time);
 		}
+		/* the node is running now, so a stream is really recording:
+		 * issue the deferred capture start (see spa_alsa_start()) */
+		defer_start_capture(state);
 	} else {
 		if (rt->driver) {
 			spa_list_remove(&rt->driver_link);
@@ -3960,7 +4012,12 @@
 	/* start capture now. We should have some data when the timer or IRQ
 	 * goes off later */
 	if (state->stream == SND_PCM_STREAM_CAPTURE) {
-		if ((err = do_start(state)) < 0)
+		/* On cards with defer_capture_start the initial start is
+		 * suppressed and postponed to defer_start_capture(), so that no
+		 * SNDRV_PCM_IOCTL_START is issued while nobody is recording. */
+		if (state->defer_capture_start)
+			spa_log_info(state->log, "%s: [385831] capture start deferred", state->name);
+		else if ((err = do_start(state)) < 0)
 			return err;
 	}
 
