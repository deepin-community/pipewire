+/* Machine-specific workaround (e.g. Phytium D3000M): issuing
+ * SNDRV_PCM_IOCTL_START during power-on initialization of the codec can
+ * make the HDA-to-USB communication hang. The initial start is therefore
+ * suppressed (see spa_alsa_start()) and re-issued here instead, once this
+ * node is actually running, which means a stream is really recording. */
+static int defer_start_capture(struct state *state)
+{
+	int res;
+	snd_pcm_state_t st;
+
+	if (SPA_LIKELY(!state->defer_capture_start ||
+			state->stream != SND_PCM_STREAM_CAPTURE))
+		return 0;
+	/* never start the capture before a stream is recording */
+	if (SPA_UNLIKELY(!state->started))
+		return 0;
+
+	/* linked PCM streams are started as a whole by the link partner,
+	 * do_start() does not issue SNDRV_PCM_IOCTL_START for them either */
+	if (state->linked) {
+		state->alsa_started = true;
+		return 0;
+	}
+
+	st = snd_pcm_state(state->hndl);
+	if (st != SND_PCM_STATE_PREPARED)
+		return 0;
+
+	spa_log_info(state->log, "%s: [385831] starting deferred capture", state->name);
+
+	if (SPA_UNLIKELY((res = snd_pcm_start(state->hndl)) < 0)) {
+		spa_log_error(state->log, "%s: [385831] snd_pcm_start: %s",
+				state->name, snd_strerror(res));
+		return res;
+	}
+	state->alsa_started = true;
+	state->alsa_sync = true;
+	spa_dll_init(&state->dll);
+	return 0;
+}
+
 static int alsa_read_sync(struct state *state, uint64_t current_time)
 {
 	int res, suppressed;
 	snd_pcm_uframes_t avail, delay, target, max_read;
 	bool following = state->following;
 
+	if (SPA_UNLIKELY((res = defer_start_capture(state)) < 0))
+		return res;
 	if (SPA_UNLIKELY(!state->alsa_started))
 		return 0;
 
