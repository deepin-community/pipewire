From 8e3a214ecfd9aece7eaabb67d29ade3496b9bbdf Mon Sep 17 00:00:00 2001
From: Wim Taymans <wtaymans@redhat.com>
Date: Mon, 16 Nov 2026 10:17:54 +0100
Subject: [PATCH] pulse-server: avoid updating pipewire. properties

There is no reason for a client to set or update pipewire. properties,
these are only managed internally in pipewire.

diff --git a/src/modules/module-protocol-pulse/message.c b/src/modules/module-protocol-pulse/message.c
index b2e6a2656..1db6ad738 100644
--- a/src/modules/module-protocol-pulse/message.c
+++ b/src/modules/module-protocol-pulse/message.c
@@ -128,6 +128,13 @@ static int read_props(struct message *m, struct pw_properties *props, bool remap
 		if (strnlen(data, size) != size - 1)
 			continue;
 
+		/* these are internal pipewire properties, a client has no business
+		 * setting or updating this. */
+		if (remap && spa_strstartswith(key, "pipewire.")) {
+			pw_log_warn("ignoring client-supplied property '%s'", key);
+			continue;
+		}
+
 		if (remap && (map = str_map_find(props_key_map, NULL, key)) != NULL) {
 			key = map->pw_str;
 			if (map->child != NULL &&

