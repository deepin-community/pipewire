From c20c0810281e16f6eaa62276065c31cb91cf9018 Mon Sep 17 00:00:00 2001
From: Chengyi Zhao <zhaochengyi@uniontech.com>
Date: Thu, 5 Nov 2026 16:20:41 +0800
Subject: [PATCH] bluez5: bap: fix parsing of 16-byte broadcast code

The Bluetooth spec defines broadcast_code as a 16-byte string, but the
">=" check rejects any input whose length is exactly 16, so a valid
broadcast code is silently discarded and the encrypted stream can never
be decrypted.

Relaxing the check is not enough: the following memcpy() copies
strlen(bcode) + 1 bytes, which writes 17 bytes into the 16-byte
broadcast_code array and causes a one-byte out-of-bounds write. Copy
exactly strlen(bcode) bytes instead.

Since the destination buffer may no longer be NUL-terminated, the debug
log must not use "%s". Use "%.*s" with the buffer size as precision to
avoid an out-of-bounds read.

diff --git a/spa/plugins/bluez5/bluez5-dbus.c b/spa/plugins/bluez5/bluez5-dbus.c
index 555a058ef..ccf704042 100644
--- a/spa/plugins/bluez5/bluez5-dbus.c
+++ b/spa/plugins/bluez5/bluez5-dbus.c
@@ -7416,10 +7416,12 @@ static void parse_broadcast_source_config(struct spa_bt_monitor *monitor, const
 			if (spa_streq(key, "broadcast_code")) {
 				if (spa_json_get_string(&it[0], bcode, sizeof(bcode)) <= 0)
 						goto parse_failed;
-				if (strlen(bcode) >= BROADCAST_CODE_LEN)
+				if (strlen(bcode) > BROADCAST_CODE_LEN)
 					goto parse_failed;
-				memcpy(big_entry->broadcast_code, bcode, strlen(bcode) + 1);
-				spa_log_debug(monitor->log, "big_entry->broadcast_code %s", big_entry->broadcast_code);
+				memcpy(big_entry->broadcast_code, bcode, strlen(bcode));
+				spa_log_debug(monitor->log, "big_entry->broadcast_code %.*s",
+						(int)sizeof(big_entry->broadcast_code),
+						big_entry->broadcast_code);
 			} else if (spa_streq(key, "adapter")) {
 				if (spa_json_get_string(&it[0], big_entry->adapter, sizeof(big_entry->adapter)) <= 0)
 					goto parse_failed;

