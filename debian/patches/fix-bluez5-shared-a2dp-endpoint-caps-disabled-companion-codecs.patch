-					AAC_OBJECT_TYPE_MPEG4_AAC_LC |
-					AAC_OBJECT_TYPE_MPEG4_AAC_ELD)))
-		return -EINVAL;
+	if (codec->id == SPA_BLUETOOTH_AUDIO_CODEC_AAC_ELD) {
