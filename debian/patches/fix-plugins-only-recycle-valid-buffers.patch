From b58c71296e8ffbc171e12ac1c330c00e9631a777 Mon Sep 17 00:00:00 2001
From: Wim Taymans <wtaymans@redhat.com>
Date: Tue, 27 Oct 2026 14:30:10 +0100
Subject: [PATCH] plugins: only recycle valid buffers

Check that the buffer_id is valid before recycling.

diff --git a/spa/plugins/audioconvert/audioconvert.c b/spa/plugins/audioconvert/audioconvert.c
index 6dc11bd5a..d130a5b79 100644
--- a/spa/plugins/audioconvert/audioconvert.c
+++ b/spa/plugins/audioconvert/audioconvert.c
@@ -3633,7 +3633,8 @@ static int impl_node_port_reuse_buffer(void *object, uint32_t port_id, uint32_t
 	spa_return_val_if_fail(CHECK_PORT(this, SPA_DIRECTION_OUTPUT, port_id), -EINVAL);
 
 	port = GET_OUT_PORT(this, port_id);
-	queue_buffer(this, port, buffer_id);
+	if (SPA_LIKELY(buffer_id < port->n_buffers))
+		queue_buffer(this, port, buffer_id);
 
 	return 0;
 }
diff --git a/spa/plugins/videoconvert/videoconvert-ffmpeg.c b/spa/plugins/videoconvert/videoconvert-ffmpeg.c
index 7d7a897c8..046d0eb71 100644
--- a/spa/plugins/videoconvert/videoconvert-ffmpeg.c
+++ b/spa/plugins/videoconvert/videoconvert-ffmpeg.c
@@ -2277,7 +2277,8 @@ static int impl_node_port_reuse_buffer(void *object, uint32_t port_id, uint32_t
 	spa_return_val_if_fail(CHECK_PORT(this, SPA_DIRECTION_OUTPUT, port_id), -EINVAL);
 
 	port = GET_OUT_PORT(this, port_id);
-	queue_buffer(this, port, buffer_id);
+	if (buffer_id < port->n_buffers)
+		queue_buffer(this, port, buffer_id);
 
 	return 0;
 }
diff --git a/src/examples/export-source.c b/src/examples/export-source.c
index a0e983de1..f657456de 100644
--- a/src/examples/export-source.c
+++ b/src/examples/export-source.c
@@ -349,7 +349,8 @@ static inline void reuse_buffer(struct data *d, uint32_t id)
 static int impl_port_reuse_buffer(void *object, uint32_t port_id, uint32_t buffer_id)
 {
 	struct data *d = object;
-	reuse_buffer(d, buffer_id);
+	if (buffer_id < d->n_buffers)
+		reuse_buffer(d, buffer_id);
 	return 0;
 }

