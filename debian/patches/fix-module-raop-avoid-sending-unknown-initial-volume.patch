From: =?UTF-8?q?Luk=C3=A1=C5=A1=20Lipinsk=C3=BD?=
 <18076-Mr-Tao@users.noreply.gitlab.freedesktop.org>
Date: Tue, 28 Jul 2026 16:49:06 +0200
Subject: [PATCH] module-raop: avoid sending unknown initial volume

rtsp_record_reply() sends impl->volume after RECORD succeeds. Before
channel volume properties have been received, impl is zero-initialized, so
this sends 0 dB and can unexpectedly raise the receiver to full volume.

Track whether a channel volume is known and gate all remote volume requests
on that state. Keep the RECORD-time request so reconnecting a stream
reasserts its previously known volume.

Fixes: e3d715dfdf17478a3d5c2e4372f36c1f38ce4836 ("module-raop: only send volume when recording")

diff --git a/src/modules/module-raop-sink.c b/src/modules/module-raop-sink.c
index a6e477162..6eab69ce1 100644
--- a/src/modules/module-raop-sink.c
+++ b/src/modules/module-raop-sink.c
@@ -266,6 +266,7 @@ struct impl {
 	unsigned int connected:1;
 	unsigned int ready:1;
 	unsigned int recording:1;
+	unsigned int volume_valid:1;
 
 	bool mute;
 	float volume;
@@ -786,7 +787,7 @@ static int rtsp_log_reply_status(void *data, int status, const struct spa_dict *
 
 static int rtsp_send_volume(struct impl *impl)
 {
-	if (!impl->recording)
+	if (!impl->recording || !impl->volume_valid)
 		return 0;
 
 	char header[128], volstr[64];
@@ -1610,6 +1611,7 @@ static void stream_props_changed(struct impl *impl, uint32_t id, const struct sp
 				volume /= n_vols;
 				volume = SPA_CLAMPF(cbrtf(volume) * 30 - 30, VOLUME_MIN, VOLUME_MAX);
 				impl->volume = volume;
+				impl->volume_valid = true;
 
 				rtsp_send_volume(impl);
 				spa_pod_builder_prop(&b, SPA_PROP_softVolumes, 0);

