From 018d78d1bb54fda7c35f70d1577842733bbcd3a2 Mon Sep 17 00:00:00 2001
From: Jan-Michael Brummer <jan.brummer@tabos.org>
Date: Tue, 11 Aug 2026 19:16:26 +0000
Subject: [PATCH] bluez5: mm: drop calls that reached the terminated state

The ModemManager backend keeps a struct call for every org.freedesktop.
ModemManager1.Call object it has seen. MMCallState is translated to the
CLCC state by mm_state_to_clcc(), which returns -1 for
MM_CALL_STATE_TERMINATED. Both callers only log that the state is
unsupported and keep the call in the list with its last known state,
e.g. CLCC_INCOMING.

ModemManager does not delete call objects on its own, this is left to
the telephony client. If the client does not do it (or if it was not
running when the call ended), no CallDeleted signal is emitted and the
terminated call stays in the list forever. Consequences:

  - mm_call_state_changed() is not run when the call ends, so the
    callsetup/call indicators keep their last value. On the next SLC
    setup AT+CIND? reports callsetup=1 and the HF signals an incoming
    call that does not exist,
  - AT+CLCC lists the terminated call, including the number, and
    mm_get_incoming_call_number() returns it for +CLIP.

Handle MM_CALL_STATE_TERMINATED explicitly: remove the call from the
list and re-evaluate the indicators. Calls in MM_CALL_STATE_UNKNOWN are
left alone as before.

Signed-off-by: Jan-Michael Brummer <jan.brummer@tabos.org>

diff --git a/spa/plugins/bluez5/modemmanager.c b/spa/plugins/bluez5/modemmanager.c
index 10310e31b..509982a2a 100644
--- a/spa/plugins/bluez5/modemmanager.c
+++ b/spa/plugins/bluez5/modemmanager.c
@@ -46,6 +46,8 @@ struct dbus_cmd_data {
 	void *user_data;
 };
 
+static void call_free(struct call *call);
+
 static int mm_state_to_clcc(struct impl *this, MMCallState state)
 {
 	switch (state) {
@@ -99,6 +101,7 @@ static void mm_get_call_properties_reply(DBusPendingCall *pending, void *user_da
 	DBusMessageIter arg_i, element_i;
 	MMCallDirection direction;
 	MMCallState state;
+	bool terminated = false;
 
 	spa_assert(call->pending == pending);
 	spa_autoptr(DBusMessage) r = steal_reply_and_unref(&call->pending);
@@ -150,17 +153,27 @@ static void mm_get_call_properties_reply(DBusPendingCall *pending, void *user_da
 
 			dbus_message_iter_get_basic(&value_i, &state);
 			spa_log_debug(this->log, "Call state: %u", state);
-			clcc_state = mm_state_to_clcc(this, state);
-			if (clcc_state < 0) {
-				spa_log_debug(this->log, "Unsupported modem state: %s, state=%d", call->path, call->state);
+			if (state == MM_CALL_STATE_TERMINATED) {
+				terminated = true;
 			} else {
-				call->state = clcc_state;
-				mm_call_state_changed(this);
+				clcc_state = mm_state_to_clcc(this, state);
+				if (clcc_state < 0) {
+					spa_log_debug(this->log, "Unsupported modem state: %s, state=%d", call->path, call->state);
+				} else {
+					call->state = clcc_state;
+					mm_call_state_changed(this);
+				}
 			}
 		}
 
 		dbus_message_iter_next(&element_i);
 	}
+
+	if (terminated) {
+		spa_log_debug(this->log, "Call %s is already terminated, dropping it", call->path);
+		call_free(call);
+		mm_call_state_changed(this);
+	}
 }
 
 static DBusHandlerResult mm_parse_voice_properties(struct impl *this, DBusMessageIter *props_i)
@@ -693,6 +706,13 @@ static DBusHandlerResult mm_filter_cb(DBusConnection *bus, DBusMessage *m, void
 			goto finish;
 		}
 
+		if (new == MM_CALL_STATE_TERMINATED) {
+			spa_log_debug(this->log, "Call %s terminated, dropping it", call->path);
+			call_free(call);
+			mm_call_state_changed(this);
+			goto finish;
+		}
+
 		clcc_state = mm_state_to_clcc(this, new);
 		if (clcc_state < 0) {
 			spa_log_debug(this->log, "Unsupported modem state: %s, state=%d", call->path, call->state);

