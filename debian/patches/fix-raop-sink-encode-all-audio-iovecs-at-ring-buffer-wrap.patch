--- repo.orig/src/modules/meson.build
+++ repo/src/modules/meson.build
@@ -624,6 +624,16 @@ if build_module_raop
     install_rpath: modules_install_dir,
     dependencies : [pipewire_module_rtp_common_dep, openssl_lib],
   )
