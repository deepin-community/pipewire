From 49675a2c3a54bf2ed4634c78885c0c4713db88c3 Mon Sep 17 00:00:00 2001
From: Wim Taymans <wtaymans@redhat.com>
Date: Tue, 3 Nov 2026 13:04:46 +0100
Subject: [PATCH] modules: remove socket and timer before stream destroy

Remove the timer and the socket sources safely with the loop locked
before destroying the stream. Else the callbacks migh try to use the
destroyed stream.

Fixes #5567

Index: repo/src/modules/module-pipe-tunnel.c
===================================================================
--- repo.orig/src/modules/module-pipe-tunnel.c
+++ repo/src/modules/module-pipe-tunnel.c
@@ -599,6 +599,21 @@ static void on_pipe_io(void *data, int f
 		handle_pipe_read(impl);
 }
 
+static int do_remove_sources(struct spa_loop *loop, bool async, uint32_t seq,
+		const void *data, size_t size, void *user_data)
+{
+	struct impl *impl = user_data;
+	if (impl->socket) {
+		pw_loop_destroy_source(impl->data_loop, impl->socket);
+		impl->socket = NULL;
+	}
+	if (impl->timer) {
+		pw_loop_destroy_source(impl->data_loop, impl->timer);
+		impl->timer = NULL;
+	}
+	return 0;
+}
+
 static int create_fifo(struct impl *impl)
 {
 	struct stat st;
@@ -671,6 +686,7 @@ static int create_fifo(struct impl *impl
 	return 0;
 
 error:
+	pw_loop_locked(impl->data_loop, do_remove_sources, 0, NULL, 0, impl);
 	if (do_unlink_fifo)
 		unlink(filename);
 	if (fd >= 0)
@@ -708,6 +724,9 @@ static const struct pw_proxy_events core
 
 static void impl_destroy(struct impl *impl)
 {
+	if (impl->data_loop)
+		pw_loop_locked(impl->data_loop, do_remove_sources, 0, NULL, 0, impl);
+
 	if (impl->stream)
 		pw_stream_destroy(impl->stream);
 	if (impl->core && impl->do_disconnect)
@@ -718,10 +737,6 @@ static void impl_destroy(struct impl *im
 			unlink(impl->filename);
 		free(impl->filename);
 	}
-	if (impl->socket)
-		pw_loop_destroy_source(impl->data_loop, impl->socket);
-	if (impl->timer)
-		pw_loop_destroy_source(impl->data_loop, impl->timer);
 	if (impl->fd >= 0)
 		close(impl->fd);
 
